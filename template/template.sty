\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{template}[2026/10/14 News digest layout]
\RequirePackage{xeCJK}
\RequirePackage{fontspec}
\RequirePackage[a3paper,landscape,margin=17mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{multicol}
\RequirePackage{hyperref}
\RequirePackage{xkeyval}
\RequirePackage{fancyhdr}
\setCJKmainfont{Noto Serif CJK SC}
\setmainfont{Latin Modern Roman}
\definecolor{newsblue}{RGB}{18,64,113}
\definecolor{newsgray}{RGB}{85,90,99}
\hypersetup{colorlinks=true,urlcolor=newsblue,linkcolor=newsblue,citecolor=newsblue}
\makeatletter
\define@key{news}{date}{\def\news@date{#1}}
\define@key{news}{vol}{\def\news@vol{#1}}
\define@key{news}{title}{\def\news@title{#1}}
\define@key{news}{author}{\def\news@author{#1}}
\define@key{news}{note}{\def\news@note{#1}}
\def\news@date{\today}
\def\news@vol{1}
\def\news@title{新闻简报}
\def\news@author{ChatGPT}
\def\news@note{}
\newcommand{\NewsSetKeys}[1]{\setkeys{news}{#1}}
\newcommand{\newsheader}{\begin{center}{\Huge\bfseries\color{newsblue}\news@title\par}\vspace{2mm}{\small\news@date\quad 第\news@vol 期\quad \news@author\par}\vspace{2mm}{\color{newsgray}\rule{\linewidth}{0.5pt}\par}\end{center}\noindent\news@note\par\vspace{3mm}}
\newenvironment{documents}{\newsheader\begin{multicols}{3}\setlength{\parindent}{0pt}\setlength{\parskip}{4pt}}{\end{multicols}}
\newcommand{\newsitem}[3]{\par\medskip{\large\bfseries\color{newsblue}#1\par}{\footnotesize\color{newsgray}#2\par}\smallskip #3\par\medskip{\color{newsgray}\rule{\linewidth}{0.25pt}}\par}
\newcommand{\newsitemwithpoints}[4]{\newsitem{#1}{#2}{#3\begin{itemize}#4\end{itemize}}}
\makeatother
\pagestyle{fancy}\fancyhf{}\fancyfoot[C]{\thepage}
